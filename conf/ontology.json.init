{
  "groups": [
    {
      "id": "http",
      "title": "WEB服务器",
      "items": [
        {
          "key": "http.port",
          "label": "端口",
          "description": "内置管理端/API 的监听端口；修改后需重启。",
          "type": "int",
          "value": 8825
        }
      ]
    },
    {
      "id": "ai",
      "title": "AI",
      "items": [
        {
          "key": "ai.maxTurns",
          "label": "最大轮次",
          "description": "单轮对话最大 tool/assistant 轮次。",
          "type": "int",
          "value": 1000
        },
        {
          "key": "ai.llmConnectTimeoutSeconds",
          "label": "大模型连接超时(秒)",
          "description": "连接大模型 API 超时（秒）。",
          "type": "int",
          "value": 30
        },
        {
          "key": "ai.llmReadTimeoutSeconds",
          "label": "大模型响应超时(秒)",
          "description": "等待大模型响应超时（秒）。",
          "type": "int",
          "value": 600
        },
        {
          "key": "ai.chatSseTimeoutSeconds",
          "label": "对话流最长存活(秒)",
          "description": "AI/训练对话流式连接最长存活时间（秒；缺省 24 小时）。",
          "type": "int",
          "value": 86400
        },
        {
          "key": "ai.llmMaxAttempts",
          "label": "大模型最大尝试次数",
          "description": "大模型调用最大尝试次数（含首次）。",
          "type": "int",
          "value": 4
        },
        {
          "key": "ai.llmSseIdleTimeoutSeconds",
          "label": "对话流空闲超时(秒)",
          "description": "对话流两次数据之间的最大空闲秒数。",
          "type": "int",
          "value": 90
        },
        {
          "key": "ai.contextWindowTokens",
          "label": "默认上下文窗口(token)",
          "description": "默认上下文窗口 token 数（模型 chat_options 未配时兜底）。",
          "type": "int",
          "value": 200000
        },
        {
          "key": "ai.chatLogEnabled",
          "label": "落盘 LLM 调用日志",
          "description": "是否落盘每次 LLM call 的请求与响应。",
          "type": "boolean",
          "value": false
        }
      ]
    },
    {
      "id": "ontologyQuery",
      "title": "本体查询",
      "items": [
        {
          "key": "openont.ontologyQuery.privacyFileOnly",
          "label": "隐私强制落盘",
          "description": "true 时 ontology_query 行数据不进入模型回执，仅写会话文件；默认 false。",
          "type": "boolean",
          "value": false
        },
        {
          "key": "openont.ontologyQuery.inlineMaxRows",
          "label": "查询最大行数",
          "description": "回执可含 data 的最大行数（含）；超过则落盘。",
          "type": "int",
          "value": 400
        },
        {
          "key": "openont.ontologyQuery.rejectMaxRows",
          "label": "查询拒绝行数",
          "description": "允许查询的最大行数（含）；超过则拒绝（非异常）。",
          "type": "int",
          "value": 10000
        }
      ]
    },
    {
      "id": "file",
      "title": "文件与 Shell",
      "items": [
        {
          "key": "file.readSizeLimit",
          "label": "read 默认字数上限",
          "description": "basic read 工具默认读取的 Unicode 码点上限。",
          "type": "int",
          "value": 16000
        },
        {
          "key": "file.globMaxResults",
          "label": "glob 结果上限",
          "description": "basic glob 返回的最大条数；超限截断。",
          "type": "int",
          "value": 100
        },
        {
          "key": "file.grepMaxResults",
          "label": "grep 结果上限",
          "description": "basic grep 返回的最大条数；超限截断。",
          "type": "int",
          "value": 100
        },
        {
          "key": "file.shellTimeout",
          "label": "shell 默认超时(毫秒)",
          "description": "basic shell 工具默认超时（毫秒）。",
          "type": "int",
          "value": 120000
        },
        {
          "key": "file.shellOutLimit",
          "label": "shell stdout 截断字数",
          "description": "shell 标准输出保留的最大码点数；超限留尾并落盘全文。",
          "type": "int",
          "value": 8000
        },
        {
          "key": "file.shellErrLimit",
          "label": "shell stderr 截断字数",
          "description": "shell 标准错误保留的最大码点数；超限留尾并落盘全文。",
          "type": "int",
          "value": 8000
        }
      ]
    },
    {
      "id": "algorithm",
      "title": "算法",
      "items": [
        {
          "key": "algorithm.pythonExecutable",
          "label": "Python 可执行文件",
          "description": "训练/推理使用的 Python 可执行文件。",
          "type": "string",
          "value": "python"
        },
        {
          "key": "algorithm.useVenv",
          "label": "独立 venv",
          "description": "是否为每个算法包创建独立 venv。",
          "type": "boolean",
          "value": true
        },
        {
          "key": "algorithm.autoInstallRequirements",
          "label": "自动安装依赖",
          "description": "训练/推理时自动 pip install requirements.txt。",
          "type": "boolean",
          "value": true
        }
      ]
    }
  ]
}
